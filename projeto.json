{
  "stack": "API em Node.js + Express, banco SQLite; interface web em HTML/CSS/JS (Vite)",
  "api": {
    "pasta": "api",
    "instalar": "npm install",
    "iniciar": "npm start",
    "testar": "npm test"
  },
  "interface": {
    "pasta": "app",
